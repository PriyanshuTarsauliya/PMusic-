<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Spotify Dark Theme -->
    <style name="Theme.Ben" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryVariant">@color/spotify_green_hover</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <item name="colorSecondary">@color/spotify_green</item>
        <item name="colorSecondaryVariant">@color/spotify_green_hover</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:statusBarColor">@color/spotify_black</item>
        <item name="android:navigationBarColor">@color/spotify_black</item>
        <item name="android:windowBackground">@color/spotify_black</item>
        <item name="android:textColorPrimary">@color/spotify_white</item>
        <item name="android:textColorSecondary">@color/spotify_subdued</item>
        <item name="bottomSheetDialogTheme">@style/SpotifyBottomSheetDialogTheme</item>
        <item name="alertDialogTheme">@style/SpotifyAlertDialogTheme</item>
    </style>

    <!-- Spotify Styled Bottom Navigation Bar -->
    <style name="Widget.Spotify.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/spotify_black</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemRippleColor">@null</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Spotify.ActiveIndicator</item>
    </style>

    <style name="Widget.Spotify.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Spotify Styled Bottom Sheet Dialog -->
    <style name="SpotifyBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SpotifyBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/spotify_black</item>
        <item name="android:statusBarColor">@color/spotify_black</item>
    </style>

    <style name="SpotifyBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Spotify Styled Dark Alert Dialog -->
    <style name="SpotifyAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/spotify_card</item>
        <item name="colorSurface">@color/spotify_card</item>
        <item name="android:textColorPrimary">@color/spotify_white</item>
        <item name="android:textColorSecondary">@color/spotify_subdued</item>
        <item name="colorSecondary">@color/spotify_green</item>
        <item name="buttonBarPositiveButtonStyle">@style/SpotifyDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/SpotifyDialogButton</item>
    </style>

    <style name="SpotifyDialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/spotify_green</item>
    </style>
</resources>
