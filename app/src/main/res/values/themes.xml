<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Spotify Dark Theme -->
    <style name="Theme.Ben" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryVariant">@color/spotify_green_hover</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <item name="colorSecondary">@color/spotify_green</item>
        <item name="colorSecondaryVariant">@color/spotify_green_hover</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:statusBarColor">@color/spotify_black</item>
        <item name="android:navigationBarColor">@color/spotify_black</item>
        <item name="android:windowBackground">@color/spotify_black</item>
        <item name="android:textColorPrimary">@color/spotify_white</item>
        <item name="android:textColorSecondary">@color/spotify_subdued</item>
    </style>

    <!-- Spotify Styled Bottom Navigation Bar -->
    <style name="Widget.Spotify.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/spotify_black</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemRippleColor">@null</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Spotify.ActiveIndicator</item>
    </style>

    <style name="Widget.Spotify.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>