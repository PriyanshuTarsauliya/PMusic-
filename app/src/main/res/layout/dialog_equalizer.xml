<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Top Drag Pill -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#44FFFFFF" />

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Equalizer"
                android:textColor="@color/spotify_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEqualizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/spotify_green"
                app:trackTint="#441DB954" />

            <ImageButton
                android:id="@+id/btnCloseEqualizer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="@color/spotify_white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Presets"
            android:textColor="@color/spotify_subdued"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Presets Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutEqPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEqFlat"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spotify_button"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Flat"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEqBass"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spotify_button_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Bass Boost"
                    android:textColor="@color/spotify_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEqVocal"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spotify_button_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Vocal Boost"
                    android:textColor="@color/spotify_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEqTreble"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spotify_button_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Treble Boost"
                    android:textColor="@color/spotify_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEqPop"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spotify_button_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Pop"
                    android:textColor="@color/spotify_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEqRock"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_spotify_button_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Rock"
                    android:textColor="@color/spotify_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Band 1: 60 Hz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="60 Hz"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBand60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="@color/spotify_green"
                android:thumbTint="@color/spotify_white" />

            <TextView
                android:id="@+id/tvBand60Val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 dB"
                android:textColor="@color/spotify_subdued"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Band 2: 230 Hz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="230 Hz"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBand230"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="@color/spotify_green"
                android:thumbTint="@color/spotify_white" />

            <TextView
                android:id="@+id/tvBand230Val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 dB"
                android:textColor="@color/spotify_subdued"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Band 3: 910 Hz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="910 Hz"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBand910"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="@color/spotify_green"
                android:thumbTint="@color/spotify_white" />

            <TextView
                android:id="@+id/tvBand910Val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 dB"
                android:textColor="@color/spotify_subdued"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Band 4: 3.6 kHz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="3.6 kHz"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBand3600"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="@color/spotify_green"
                android:thumbTint="@color/spotify_white" />

            <TextView
                android:id="@+id/tvBand3600Val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 dB"
                android:textColor="@color/spotify_subdued"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Band 5: 14 kHz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="14 kHz"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBand14000"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="@color/spotify_green"
                android:thumbTint="@color/spotify_white" />

            <TextView
                android:id="@+id/tvBand14000Val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 dB"
                android:textColor="@color/spotify_subdued"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Reset Button -->
        <Button
            android:id="@+id/btnResetEqualizer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="RESET TO FLAT"
            android:textColor="@color/spotify_subdued"
            android:textSize="12sp"
            android:textStyle="bold"
            app:strokeColor="@color/spotify_subdued" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

