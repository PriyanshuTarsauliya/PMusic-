# ==============================================================================
# PMUSIC ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your secrets & API credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER NETWORK & RUNTIME
# ------------------------------------------------------------------------------
PORT=3456
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. LOAD BALANCER & CLUSTERING ORCHESTRATION
# ------------------------------------------------------------------------------
# Set to 'true' to enable multi-core cluster load balancing across CPU cores
ENABLE_CLUSTER=false
# Number of worker processes to spawn (defaults to CPU core count up to 2)
WORKERS=2
# Force single-process mode (recommended for cloud containers like Render)
NO_CLUSTER=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS (CHANGE IN PRODUCTION!)
# ------------------------------------------------------------------------------
# 256-bit secret used to sign JWT access tokens
JWT_SECRET=pmusic_jwt_master_secret_key_prod_256bit_secure_seed!

# Session cookie signing key
SESSION_SECRET=pmusic_session_cookie_secret_key_9876543210_v1

# HMAC secret for anti-bot Proof-of-Work cryptographic challenge generation
CHALLENGE_HMAC_SECRET=pmusic_challenge_hmac_secret_anti_bot_32bytes!

# Superuser administrative key for rate limit resets and feedback management
ADMIN_KEY=pmusic_admin_secret_super_key_2026!

# ------------------------------------------------------------------------------
# 4. SPOTIFY DEVELOPER API (OAUTH & CATALOG INTEGRATION)
# Register your app at: https://developer.spotify.com/dashboard
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3456/api/auth/spotify/callback

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY SEARCH, AUDIO & LYRICS APIs
# ------------------------------------------------------------------------------
# YouTube Data API v3 Key (Optional: automated scraper resolver is used if empty)
YOUTUBE_API_KEY=

# iTunes Search API Endpoint
ITUNES_API_URL=https://itunes.apple.com

# LRCLIB Synced & Plain Lyrics Resolver Endpoint
LRCLIB_API_URL=https://lrclib.net/api

# ------------------------------------------------------------------------------
# 6. CLIENT CORS & APPLICATION URLS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3456,http://127.0.0.1:3456,http://10.0.2.2:3456
CLIENT_BASE_URL=http://localhost:3456

